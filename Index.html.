<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Диар & Дильяра — Үйлену тойына шақырту</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --emerald-dark: #0a1c14;
            --emerald-card: rgba(14, 38, 27, 0.75);
            --ivory: #fcfbf7;
            --cream: #f4f0ea;
            --gold: #d4af37;
            --gold-light: #f3e5ab;
            --beige: #d8c7b5;
            --transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--emerald-dark);
            color: var(--ivory);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            position: relative;
            -webkit-font-smoothing: antialiased;
        }

        /* Background overlay & effects */
        .bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at center, #113322 0%, #06110c 100%);
            z-index: -2;
        }

        /* Floating gold particles */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--gold);
            border-radius: 50%;
            opacity: 0.3;
            animation: floatParticle 10s infinite linear;
        }

        @keyframes floatParticle {
            0% { transform: translateY(100vh) translateX(0); opacity: 0; }
            50% { opacity: 0.6; }
            100% { transform: translateY(-10vh) translateX(50px); opacity: 0; }
        }

        /* Kazakh Ornaments corners */
        .ornament-corner {
            position: absolute;
            width: 80px;
            height: 80px;
            border: 1px solid rgba(212, 175, 55, 0.3);
            pointer-events: none;
            z-index: 5;
        }
        .ornament-top-left { top: 15px; left: 15px; border-right: none; border-bottom: none; }
        .ornament-top-right { top: 15px; right: 15px; border-left: none; border-bottom: none; }
        .ornament-bottom-left { bottom: 15px; left: 15px; border-right: none; border-top: none; }
        .ornament-bottom-right { bottom: 15px; right: 15px; border-left: none; border-top: none; }

        /* Typography */
        h1, h2, h3, .script-font {
            font-family: 'Cormorant Garamond', serif;
        }

        .names-font {
            font-family: 'Pinyon Script', cursive;
        }

        /* Cover Section */
        #cover-section {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            background: linear-gradient(rgba(10, 28, 20, 0.85), rgba(10, 28, 20, 0.95)), url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1000&auto=format&fit=crop') no-repeat center center/cover;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 50px 20px;
            z-index: 1000;
            transition: opacity 1s ease, visibility 1s ease;
            text-align: center;
        }

        #cover-section.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .cover-top {
            margin-top: 20px;
            letter-spacing: 3px;
            font-size: 0.85rem;
            color: var(--gold-light);
            text-transform: uppercase;
        }

        .cover-center {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cover-center h1 {
            font-size: clamp(3.8rem, 12vw, 6.5rem);
            color: var(--gold);
            line-height: 1;
            margin: 10px 0;
            text-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .cover-center .amp {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 2rem;
            color: var(--beige);
            margin: -5px 0;
        }

        .cover-bottom {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 320px;
            margin-bottom: 20px;
        }

        .open-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
            color: var(--emerald-dark);
            border: none;
            width: 100%;
            padding: 18px 30px;
            border-radius: 50px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 1.5px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .open-btn:active {
            transform: scale(0.96);
        }

        .music-notice {
            font-size: 0.75rem;
            color: var(--beige);
            margin-top: 12px;
            letter-spacing: 0.5px;
            opacity: 0.8;
        }

        /* Main Content */
        #main-content {
            opacity: 0;
            transition: opacity 1.5s ease;
            max-width: 600px;
            margin: 0 auto;
            padding: 0 20px 80px 20px;
            position: relative;
        }

        #main-content.visible {
            opacity: 1;
        }

        section {
            padding: 70px 0;
            text-align: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        }

        section:last-child {
            border-bottom: none;
        }

        /* Invitation Message Section */
        .invitation-header h2 {
            font-size: 1.1rem;
            letter-spacing: 4px;
            color: var(--gold);
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .invitation-text {
            font-size: 1.05rem;
            line-height: 1.8;
            color: var(--cream);
            font-weight: 300;
            margin-bottom: 30px;
        }

        .invitation-names {
            font-size: 3.5rem;
            color: var(--gold);
            margin-top: 15px;
        }

        /* Info Cards Section */
        .cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 30px;
        }

        .info-card {
            background: var(--emerald-card);
            border: 1px solid rgba(212, 175, 55, 0.25);
            padding: 25px 15px;
            border-radius: 16px;
            backdrop-filter: blur(10px);
            transition: transform 0.3s ease;
        }

        .info-card:hover {
            transform: translateY(-5px);
        }

        .info-card i {
            font-size: 1.6rem;
            color: var(--gold);
            margin-bottom: 12px;
        }

        .info-card h3 {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: var(--beige);
            margin-bottom: 8px;
            text-transform: uppercase;
            font-family: 'Montserrat', sans-serif;
            font-weight: 500;
        }

        .info-card p {
            font-size: 1.1rem;
            color: var(--ivory);
            font-weight: 500;
            line-height: 1.4;
        }

        .info-card p.small {
            font-size: 0.9rem;
            color: var(--cream);
            margin-top: 4px;
        }

        /* Maps Button */
        .map-btn-container {
            margin-top: 35px;
        }

        .gold-btn {
            background: transparent;
            color: var(--gold);
            border: 1px solid var(--gold);
            padding: 15px 35px;
            border-radius: 50px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 1.5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .gold-btn:hover {
            background: var(--gold);
            color: var(--emerald-dark);
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.3);
        }

        /* Quote Section */
        .quote-box {
            position: relative;
            padding: 40px 20px;
            background: rgba(255,255,255,0.02);
            border-radius: 20px;
            border: 1px dashed rgba(212, 175, 55, 0.3);
        }

        .quote-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-style: italic;
            line-height: 1.7;
            color: var(--cream);
            margin-bottom: 20px;
        }

        .heart-icon {
            color: var(--gold);
            font-size: 1.2rem;
        }

        /* Countdown Section */
        .countdown-title {
            font-size: 1.1rem;
            letter-spacing: 3px;
            color: var(--gold);
            margin-bottom: 30px;
            text-transform: uppercase;
        }

        .countdown-grid {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .countdown-item {
            background: var(--emerald-card);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 12px;
            padding: 15px 10px;
            min-width: 70px;
            backdrop-filter: blur(5px);
        }

        .countdown-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--gold-light);
            line-height: 1;
            margin-bottom: 5px;
        }

        .countdown-label {
            font-size: 0.65rem;
            letter-spacing: 1px;
            color: var(--beige);
            text-transform: uppercase;
        }

        .countdown-finished {
            font-size: 1.5rem;
            color: var(--gold);
            font-family: 'Cormorant Garamond', serif;
            line-height: 1.5;
        }

        /* Dedicated Music Player Section */
        .player-box {
            background: var(--emerald-card);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 25px;
            margin-top: 10px;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .player-info {
            margin-bottom: 15px;
        }

        .player-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--ivory);
            margin-bottom: 4px;
        }

        .player-artist {
            font-size: 0.85rem;
            color: var(--beige);
        }

        .player-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
        }

        .play-pause-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--gold);
            border: none;
            color: var(--emerald-dark);
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
        }

        .play-pause-btn:active {
            transform: scale(0.92);
        }

        .progress-container {
            width: 100%;
            height: 4px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            cursor: pointer;
            margin-top: 15px;
            position: relative;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: var(--gold);
            border-radius: 2px;
            position: relative;
            transition: width 0.1s linear;
        }

        /* Floating Music Button (Bottom Right) */
        #floatingMusicBtn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 50px;
            height: 50px;
            background: var(--emerald-dark);
            border: 2px solid var(--gold);
            border-radius: 50%;
            color: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            z-index: 999;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s ease;
        }

        #floatingMusicBtn.visible {
            opacity: 1;
            visibility: visible;
        }

        #floatingMusicBtn.playing {
            animation: pulseGlow 2s infinite;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }
            70% { box-shadow: 0 0 0 12px rgba(212, 175, 55, 0); }
            100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
        }

        /* Final Section */
        .final-section {
            padding-bottom: 40px;
        }

        .final-title {
            font-size: 1.3rem;
            letter-spacing: 2px;
            color: var(--gold);
            line-height: 1.6;
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        .final-names {
            font-size: 3rem;
            color: var(--ivory);
            margin: 15px 0;
        }

        .final-date {
            font-size: 1.1rem;
            color: var(--beige);
            letter-spacing: 3px;
            margin-bottom: 20px;
        }

        .final-footer-text {
            font-size: 1rem;
            color: var(--gold-light);
            font-style: italic;
        }

        /* Animation utilities */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>

    <div class="bg-overlay"></div>
    
    <div class="particles" id="particlesContainer"></div>

    <audio id="weddingMusic" loop preload="auto">
        <source src="mahabbat.mp3" type="audio/mpeg">
        Сайт браузеріңіз аудионы қолдамайды.
    </audio>

    <div id="cover-section">
        <div class="ornament-corner ornament-top-left"></div>
        <div class="ornament-corner ornament-top-right"></div>
        <div class="ornament-corner ornament-bottom-left"></div>
        <div class="ornament-corner ornament-bottom-right"></div>

        <div class="cover-top">
            БІЗДІҢ ЕҢ БАСТЫ КҮНІМІЖГЕ
        </div>

        <div class="cover-center">
            <span style="font-size: 0.9rem; letter-spacing: 3px; color: var(--beige); text-transform: uppercase; margin-bottom: 5px;">шақырамыз!</span>
            <h1>Диар</h1>
            <div class="amp">&</div>
            <h1>Дильяра</h1>
        </div>

        <div class="cover-bottom">
            <button class="open-btn" id="openInvitationBtn">
                <i class="fa-regular fa-heart"></i> ШАҚЫРТУДЫ АШУ
            </button>
            <div class="music-notice">♪ МУЗЫКАМЕН БІРГЕ АШЫЛАДЫ</div>
        </div>
    </div>

    <div id="floatingMusicBtn" title="Музыканы қосу/өшіру">
        <i class="fa-solid fa-music" id="floatingMusicIcon"></i>
    </div>

    <div id="main-content">

        <section class="reveal">
            <div class="invitation-header">
                <h2>ҚҰРМЕТТІ ҚОНАҚТАР!</h2>
            </div>
            <p class="invitation-text">
                Біздің өміріміздегі ең маңызды күннің куәсі болуға шақырамыз!<br>
                Ақ тілектеріңізбен келіп, қуанышымызды бірге бөлісіп, мерекеміздің қадірлі қонағы болыңыздар!
            </p>
            <div class="names-font invitation-names">Диар & Дильяра</div>
        </section>

        <section class="reveal">
            <div class="cards-grid">
                <div class="info-card">
                    <i class="fa-regular fa-calendar-days"></i>
                    <h3>КҮНІ</h3>
                    <p>26.12.2026</p>
                </div>
                <div class="info-card">
                    <i class="fa-regular fa-clock"></i>
                    <h3>УАҚЫТЫ</h3>
                    <p>20:00</p>
                </div>
                <div class="info-card" style="grid-column: span 2;">
                    <i class="fa-solid fa-location-dot"></i>
                    <h3>МЕКЕНЖАЙЫ</h3>
                    <p>Atyrau Hall</p>
                    <p class="small">43-я улица, 57а</p>
                </div>
            </div>

            <div class="map-btn-container">
                <a href="https://maps.google.com/?q=Atyrau+Hall+43-я+улица+57а+Атырау" target="_blank" class="gold-btn">
                    <i class="fa-solid fa-map-location-dot"></i> КАРТАДАН КӨРУ
                </a>
            </div>
        </section>

        <section class="reveal">
            <div class="quote-box">
                <p class="quote-text">
                    «Екі жүрек, бір тағдыр, бір бақытқа бастар жаңа өміріміздің алғашқы қадамын сіздермен бірге бастағымыз келеді.»
                </p>
                <div class="heart-icon">♡</div>
            </div>
        </section>

        <section class="reveal">
            <div class="countdown-title">ТОЙҒА ҚАЛҒАН УАҚЫТ</div>
            <div class="countdown-grid" id="countdownContainer">
                <div class="countdown-item">
                    <div class="countdown-number" id="days">000</div>
                    <div class="countdown-label">Күн</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number" id="hours">00</div>
                    <div class="countdown-label">Сағат</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number" id="minutes">00</div>
                    <div class="countdown-label">Минут</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number" id="seconds">00</div>
                    <div class="countdown-label">Секунд</div>
                </div>
            </div>
        </section>

        <section class="reveal">
            <div class="player-box">
                <div class="player-info">
                    <div class="player-title">Махаббат деген қандайды</div>
                    <div class="player-artist">Қызбек Құрайыш</div>
                </div>
                <div class="progress-container" id="progressContainer">
                    <div class="progress-bar" id="progressBar"></div>
                </div>
                <div class="player-controls">
                    <button class="play-pause-btn" id="playerToggleBtn">
                        <i class="fa-solid fa-play" id="playerToggleIcon"></i>
                    </button>
                </div>
            </div>
        </section>

        <section class="reveal final-section">
            <div class="final-title">
                БІЗДІҢ ҚУАНЫШЫМЫЗДЫ<br>БӨЛІСУГЕ КЕЛГЕНІҢІЗ ҮШІН РАҚМЕТ!
            </div>
            <div class="names-font final-names">Диар & Дильяра</div>
            <div class="final-date">26.12.2026</div>
            <div class="final-footer-text">Сіздерді асыға күтеміз! ❤️</div>
        </section>

    </div>

    <script>
        // Generate floating particles
        const particlesContainer = document.getElementById('particlesContainer');
        for (let i = 0; i < 25; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            p.style.left = Math.random() * 100 + '%';
            p.style.top = Math.random() * 100 + '%';
            p.style.animationDuration = (8 + Math.random() * 7) + 's';
            p.style.animationDelay = (Math.random() * 5) + 's';
            particlesContainer.appendChild(p);
        }

        // Audio & Interaction Logic
        const audio = document.getElementById('weddingMusic');
        const openBtn = document.getElementById('openInvitationBtn');
        const coverSection = document.getElementById('cover-section');
        const mainContent = document.getElementById('main-content');
        const floatingMusicBtn = document.getElementById('floatingMusicBtn');
        const floatingMusicIcon = document.getElementById('floatingMusicIcon');
        const playerToggleBtn = document.getElementById('playerToggleBtn');
        const playerToggleIcon = document.getElementById('playerToggleIcon');
        const progressBar = document.getElementById('progressBar');
        const progressContainer = document.getElementById('progressContainer');

        let isPlaying = false;

        function togglePlay() {
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                floatingMusicBtn.classList.remove('playing');
                floatingMusicIcon.className = "fa-solid fa-music";
                playerToggleIcon.className = "fa-solid fa-play";
            } else {
                audio.play().then(() => {
                    isPlaying = true;
                    floatingMusicBtn.classList.add('playing');
                    floatingMusicIcon.className = "fa-solid fa-pause";
                    playerToggleIcon.className = "fa-solid fa-pause";
                }).catch(e => {
                    console.log("Audio play blocked:", e);
                });
            }
        }

        openBtn.addEventListener('click', () => {
            coverSection.classList.add('hidden');
            mainContent.classList.add('visible');
            floatingMusicBtn.classList.add('visible');
            
            // Start audio safely upon user gesture
            audio.play().then(() => {
                isPlaying = true;
                floatingMusicBtn.classList.add('playing');
                floatingMusicIcon.className = "fa-solid fa-pause";
                playerToggleIcon.className = "fa-solid fa-pause";
            }).catch(err => {
                console.log("Audio auto-play error:", err);
            });

            // Trigger initial scroll check
            checkScrollReveal();
        });

        floatingMusicBtn.addEventListener('click', togglePlay);
        playerToggleBtn.addEventListener('click', togglePlay);

        // Update progress bar
        audio.addEventListener('timeupdate', () => {
            if (audio.duration) {
                const percent = (audio.currentTime / audio.duration) * 100;
                progressBar.style.width = percent + '%';
            }
        });

        progressContainer.addEventListener('click', (e) => {
            const width = progressContainer.clientWidth;
            const clickX = e.offsetX;
            const duration = audio.duration;
            if (duration) {
                audio.currentTime = (clickX / width) * duration;
            }
        });

        // Countdown Timer (UTC+5 Kazakhstan timezone)
        const weddingDate = new Date('2026-12-26T20:00:00+05:00');

        function updateCountdown() {
            const now = new Date();
            const diff = weddingDate - now;

            if (diff <= 0) {
                document.getElementById('countdownContainer').innerHTML = `
                    <div class="countdown-finished">БҮГІН БІЗДІҢ ЕҢ БАҚЫТТЫ КҮНІМІЗ! ❤️</div>
                `;
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('days').innerText = String(days).padStart(3, '0');
            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Scroll Reveal Animation
        function checkScrollReveal() {
            const reveals = document.querySelectorAll('.reveal');
            reveals.forEach(el => {
                const windowHeight = window.innerHeight;
                const elementTop = el.getBoundingClientRect().top;
                const elementVisible = 100;
                if (elementTop < windowHeight - elementVisible) {
                    el.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', checkScrollReveal);
    </script>
</body>
</html>
